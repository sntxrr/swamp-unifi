# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section

# --- site-specific, not part of the publishable extension ---
# Model instances carry the controller host + admin username in plaintext.
/models/
# Vault definitions point at local paths (secrets themselves live in .swamp/).
/vaults/
# Desired reservation sets are a MAC/IP inventory of the home network.
/desired-*.json
# Same class of data, and the /desired-*.json glob does not catch them:
# fabric-devices.json is the adopted-hardware MAC/IP set, and the rollback
# inventory is a full dump of every host on the network -- MACs, hostnames and
# vendor OUIs for ~110 devices, including personal ones. Both were tracked by
# mistake and were removed from history on 2026-07-31 before this repo's first
# push carrying them. They stay on disk: the drift-watch crons read them with
# --input-file, exactly as they read desired-phase2.json.
/fabric-devices.json
/rollback-inventory-*.json

# .swamp.yaml carries the datastore block, which names an S3 bucket. The bucket
# is locked down, so the name is an information disclosure rather than an access
# hole -- but it still makes a target easier to find, and this repo is public.
# Only .swamp.yaml.example is tracked.
.swamp.yaml
