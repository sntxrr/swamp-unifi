# --- site-specific, not part of the publishable extension ---
# Model instances carry the controller host + admin username in plaintext.
/models/
# Vault definitions point at local paths (secrets themselves live in .swamp/).
/vaults/
# Desired reservation sets are a MAC/IP inventory of the home network.
/desired-*.json
